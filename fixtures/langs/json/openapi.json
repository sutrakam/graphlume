      "PetList": { "type": "array", "items": { "$ref": "#/components/schemas/Pet" } },
      "Error": { "type": "object" }
    },
    "parameters": {
      "Limit": { "name": "limit", "in": "query" }
    },
    "responses": {
      "NotFound": { "description": "missing" }
    }
  }
