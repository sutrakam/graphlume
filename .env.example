# Environment variables graphlume reads. All are optional; each has a default.
# Copy to .env.local to set one. Nothing here is required to index or serve.

# Where graphlume keeps user-level configuration. Defaults to the platform config
# directory.
GRAPHLUME_CONFIG_HOME=

# Linux and macOS config base, used when GRAPHLUME_CONFIG_HOME is unset.
XDG_CONFIG_HOME=

# Windows application data directory, used by `graphlume install` when present.
APPDATA=

# Docker credential directory, read when indexing images that need registry
# credentials. Defaults to ~/.docker.
DOCKER_CONFIG=

# Codex CLI home, read by `graphlume install` to find config.toml. Defaults to
# ~/.codex.
CODEX_HOME=

# Kimi Code CLI home, read by `graphlume install` to find mcp.json. Defaults to
# ~/.kimi-code.
KIMI_CODE_HOME=

# Bearer token for `graphlume serve --http`, at least 24 characters. When unset a
# random token is generated for each run and written to .graphlume/mcp-token
# (readable only by you).
GRAPHLUME_MCP_TOKEN=
